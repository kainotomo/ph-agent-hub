# =============================================================================
# PH Agent Hub — Frontend Dockerfile (Production)
# =============================================================================
# Multi-stage build:
#   1. build — installs deps + compiles TypeScript/Vite production bundle
#   2. final — nginx serving the static files
#
# Built by: infrastructure/build.sh
# =============================================================================

# ── Build stage ────────────────────────────────────────────────────────────
FROM node:20-alpine AS build

WORKDIR /app

# Copy the lockfile so the exact dependency tree is installed.
# `npm install` without it crashes npm 10.8.2 (bundled in node:20-alpine)
# while resolving vitest's nested vite dependency.
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .
RUN npm run build

# ── Final stage (nginx) ────────────────────────────────────────────────────
FROM nginx:alpine

# Copy built assets from build stage
COPY --from=build /app/dist /usr/share/nginx/html

# Copy nginx configuration (as template) and entrypoint
COPY nginx.conf /etc/nginx/conf.d/default.conf.template
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 3000

CMD ["/entrypoint.sh"]
